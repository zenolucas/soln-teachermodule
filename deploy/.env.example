# Copy to deploy/.env and fill in. Never commit the real file.

# The public hostname. Its DNS A/AAAA record must point at this server, and
# ports 80 and 443 must be reachable, so Caddy can get a certificate.
DOMAIN=soln.example.com

# Database. The schema in soln_db.sql uses the database name soln_db.
DB_ROOT_PASSWORD=change-me
DBUSER=soln
DBPASS=change-me-too
DBNAME=soln_db

# At least 32 random characters each, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
GAME_TOKEN_SECRET=
