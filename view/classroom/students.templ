package classroom

import "soln-teachermodule/view/layout"
import "soln-teachermodule/view/ui"
import "soln-teachermodule/types"
import "fmt"

// StudentsPage is classroom.Students' actual content - split into its own file (T2.2)
// since it's grown past a one-liner: the restyled table, its row-loading fragment, and
// the add-students modal.
templ StudentsPage(p layout.Page, room types.Classroom) {
	@layout.Base(p) {
		<div class="w-full min-h-full bg-base-300 justify-center gap-4 overflow-x-auto">
			@ui.PageHeader(ui.Header{Crumbs: classroomCrumbs(room), Title: "Students"}) {
				<span class="text-[15px] opacity-60 mr-2"><span id="enrolled-count">…</span> enrolled</span>
				<button type="button" class="btn btn-primary btn-sm" data-modal-open="modal_add_students">Add students</button>
			}
			<div class="px-4 pb-4">
				<!-- get unenrolled students for add students - innerHTML (the default), not
				     outerHTML: #getunenrolledstudents is now a plain div (T2.4b), not a row
				     wrapper, and UnenrolledRows' response doesn't re-declare that id. An
				     outerHTML swap here would replace the div itself and take the id with
				     it, breaking every hx-get the search box (addstudents.templ) targets at
				     it afterward. -->
				<form hx-post="/unenrolledstudents" hx-trigger="load" hx-target="#getunenrolledstudents">
					<input type="hidden" name="classroomID" value={ room.ClassroomID } />
				</form>
				<!-- GET alias (DEC-7): the old /students POST stays registered too, until
				     nothing else posts to it. The target is this wrapping div, not the
				     <tbody>/<tr> elements directly - htmx 1.x picks its fragment parser's
				     context by sniffing the response's first tag, so a response mixing bare
				     <tr>s with an out-of-band element (see StudentRows) has no single tag that
				     works for both; targeting a plain div sidesteps the whole problem, since
				     the response's own <table> carries its own correct parsing context.
				     Confirmed live: targeting the <tbody> directly corrupted every row
				     (regardless of the OOB span's position) or threw htmx:swapError outright. -->
				<div id="students-table" hx-get={ fmt.Sprintf("/students?classroomID=%s", room.ClassroomID) } hx-trigger="load" hx-target="this">
					<div class="overflow-x-auto bg-base-100 rounded-box border border-base-content/10 flex justify-center p-8">
						<span class="loading loading-spinner" aria-label="Loading"></span>
					</div>
				</div>
			</div>
			@AddStudentsForm(room.ClassroomID, room.Section)
		</div>
	}
}

// StudentRows is the enrolled-students table, loaded via hx-get so the page shell (and
// the "Add students" modal it shares no dependency on) can render immediately without
// waiting on this query. The trailing <span hx-swap-oob="true"> updates the header's
// "{n} enrolled" count out of band, in the same response - no separate request just to
// learn how many rows came back.
templ StudentRows(classroomID string, students []types.Student) {
	<div class="overflow-x-auto bg-base-100 rounded-box border border-base-content/10">
		<table class="table table-zebra">
			<thead>
				<tr>
					<th>Name</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				if len(students) == 0 {
					<tr>
						<td colspan="2" class="text-center text-neutral">No students enrolled yet.</td>
					</tr>
				} else {
					for _, student := range students {
						<tr id={ fmt.Sprintf("student-%s", student.UserID) } class="h-[60px]">
							<td>
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 shrink-0 rounded-full bg-secondary text-white flex items-center justify-center text-xs font-bold">
										{ ui.Initials(student.Firstname, student.Lastname) }
									</div>
									<span>{ student.Firstname } { student.Lastname }</span>
								</div>
							</td>
							<td>
								<div class="flex justify-end items-center gap-2">
									<a href={ templ.URL(fmt.Sprintf("/student/score?userID=%s&classroomID=%s", student.UserID, classroomID)) } class="btn btn-primary btn-sm">View scores</a>
									<div class="dropdown dropdown-end">
										<div tabindex="0" role="button" aria-label="More actions" class="btn btn-sm btn-ghost">
											<i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
										</div>
										<ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[1] w-52 p-2 shadow">
											<li>
												<form hx-post="/delete/student" hx-target={ fmt.Sprintf("#student-%s", student.UserID) } hx-swap="outerHTML swap:1s" hx-confirm="Are you sure you want to remove this student?">
													<input type="hidden" name="studentID" value={ student.UserID } />
													<input type="hidden" name="classroomID" value={ classroomID } />
													<button type="submit" class="text-error">Remove from class</button>
												</form>
											</li>
										</ul>
									</div>
								</div>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
	<span id="enrolled-count" hx-swap-oob="true">{ fmt.Sprint(len(students)) }</span>
}
