package classroom

import "soln-teachermodule/view/layout"
import "soln-teachermodule/types"
import "fmt"

// classroomHeader is shared by Overview/Minigames/Students - each is now its own route
// (T1.1) instead of a tab panel in one page, but they still show the same classroom
// name/section/description header (see FE-12).
templ classroomHeader(room types.Classroom) {
	<div class="px-4 pt-4">
		<h2 class="text-2xl font-bold">{ room.ClassroomName } &mdash; Section { room.Section }</h2>
		if len(room.Description) > 0 {
			<p class="text-sm opacity-70">{ room.Description }</p>
		}
	</div>
}

templ Overview(p layout.Page, room types.Classroom) {
	@layout.Base(p) {
		<!-- No sidebar column here anymore - layout.Base renders one shared ui.Sidebar for
		     every authenticated page now (T1.4 gives it real Active-state navigation, so
		     T1.1's temporary link row is gone), this page just fills the remaining width
		     (see FE-11, D4). -->
		<div class="w-full min-h-full bg-base-300 justify-center gap-4 overflow-x-auto">
			@classroomHeader(room)
			<!-- Interim Overview: just links to the other three sections. T4.7 replaces this
			     grid with the real summary (C3: student count, quiz average, students per
			     world, flagged count, Needs attention). -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 px-4 pb-4">
				<a href={ templ.URL(fmt.Sprintf("/classroom/minigames?classroom_id=%s", room.ClassroomID)) } class="card bg-base-200 hover:bg-base-100">
					<div class="card-body items-center text-center">
						<i class="fa-solid fa-gamepad fa-2xl" aria-hidden="true"></i>
						<h2 class="card-title">Minigames</h2>
						<p class="text-sm opacity-70">Edit questions and view per-scene statistics.</p>
					</div>
				</a>
				<a href={ templ.URL(fmt.Sprintf("/classroom/students?classroom_id=%s", room.ClassroomID)) } class="card bg-base-200 hover:bg-base-100">
					<div class="card-body items-center text-center">
						<i class="fa-solid fa-users fa-2xl" aria-hidden="true"></i>
						<h2 class="card-title">Students</h2>
						<p class="text-sm opacity-70">Manage who's enrolled in this classroom.</p>
					</div>
				</a>
				<a href={ templ.URL(fmt.Sprintf("/classroom/statistics?classroom_id=%s", room.ClassroomID)) } class="card bg-base-200 hover:bg-base-100">
					<div class="card-body items-center text-center">
						<i class="fa-solid fa-chart-simple fa-2xl" aria-hidden="true"></i>
						<h2 class="card-title">Statistics</h2>
						<p class="text-sm opacity-70">See how students are doing across every scene.</p>
					</div>
				</a>
			</div>
		</div>
	}
}

templ Minigames(p layout.Page, room types.Classroom) {
	@layout.Base(p) {
		<div class="w-full min-h-full bg-base-300 justify-center gap-4 overflow-x-auto">
			@classroomHeader(room)
			<!-- One Go slice (types.Worlds/types.Scene) replaces what used to be these
			     12 copy-pasted hero blocks, one per scene (see FE-13). -->
			for _, world := range types.Worlds {
				<h1 class="text-5xl font-bold">{ world.Title }</h1>
				<p class="py-6 text-xl">{ world.Intro }</p>
				for _, scene := range world.Scenes {
					<div class="hero bg-base-200 mb-4">
						<div class="hero-content flex-col lg:flex-row">
							<img src={ scene.Image } alt={ scene.Alt }
								class="max-w-sm rounded-lg shadow-2xl" />
							<div>
								<h1 class="text-2xl font-bold">{ scene.Name }</h1>
								<p class="py-6 text-xl">{ scene.Blurb }</p>
								<a href={ templ.URL(fmt.Sprintf("/minigame?minigameID=%d&classroomID=%s", scene.MinigameID, room.ClassroomID))} class="btn btn-primary text-white">Edit Questions</a>
								<a href={ templ.URL(fmt.Sprintf("%s?minigameID=%d&classroomID=%s", scene.StatsPath(), scene.MinigameID, room.ClassroomID))} class="btn btn-primary text-white">View Statistics</a>
							</div>
						</div>
					</div>
				}
			}
		</div>
	}
}

templ Students(p layout.Page, room types.Classroom) {
	@layout.Base(p) {
		<div class="w-full min-h-full bg-base-300 justify-center gap-4 overflow-x-auto">
			@classroomHeader(room)
			<div class="overflow-x-auto">
				<!-- get unenrolled students for add students -->
				<form hx-post="/unenrolledstudents" hx-trigger="load" hx-swap="outerHTML"
					hx-target="#getunenrolledstudents">
					<input type="hidden" name="classroomID" value={ room.ClassroomID } />
				</form>

				<div class="flex justify-center">
					<button type="button" class="btn btn-primary text-white" data-modal-open="modal_add_students">Add Students</button>
				</div>
				<table class="table table-zebra text-xl">
					<thead>
						<tr>
							<th></th>
							<th class="text-xl">Name</th>
							<th></th>
						</tr>
					</thead>
				<!-- get enrolled students -->
					<form hx-post="/students" hx-trigger="load" hx-swap="outerHTML" hx-target="#getstudents">
						<input type="hidden" name="classroomID" value={ room.ClassroomID } />
					</form>
						<tbody id="getstudents">
							<tr><td colspan="3" class="text-center"><span class="loading loading-spinner" aria-label="Loading"></span></td></tr>
						</tbody>
				</table>
			</div>
			@AddStudentsForm(room.ClassroomID)
		</div>
	}
}

templ AddStudentsForm(classroomID string) {
<dialog id="modal_add_students" class="modal">
	<!-- max-h + flex-col keeps Cancel/Add always in view: the long student list scrolls
	     inside its own flex-1 region instead of pushing the action row past the bottom
	     of the viewport, which is what the checkbox-hack version did (see FE-43). -->
	<div class="modal-box w-full max-h-[80vh] flex flex-col min-h-0">
		<h3 class="text-lg font-bold">Add Students</h3>
		<form id="add-students-form" hx-post="/addstudents" hx-swap="outerHTML" class="flex flex-col flex-1 min-h-0">
			<input type="hidden" name="classroomID" value={ classroomID } />
			<label class="label cursor-pointer justify-start gap-2 w-fit">
				<input type="checkbox" id="select-all" class="checkbox"/> Select All
			</label>
			<div class="overflow-y-auto flex-1 min-h-0">
				<table class="table table-zebra text-xl">
					<!-- head -->
					<thead>
						<tr>
							<th></th>
							<th></th>
						</tr>
					</thead>
					<tbody id="getunenrolledstudents">
						<tr><td colspan="2" class="text-center"><span class="loading loading-spinner" aria-label="Loading"></span></td></tr>
					</tbody>
				</table>
			</div>
		</form>
		<div class="modal-action">
			<button type="button" class="btn" data-modal-close>Cancel</button>
			<button type="submit" form="add-students-form" class="btn btn-secondary">Add</button>
		</div>
	</div>
	<form method="dialog" class="modal-backdrop">
		<button>close</button>
	</form>
</dialog>
}
