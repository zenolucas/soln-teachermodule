package classroom

import "soln-teachermodule/view/layout"
import "soln-teachermodule/view/ui"
import "soln-teachermodule/types"
import "fmt"

// classroomCrumbs is shared by Overview/Minigames/Students - each is now its own route
// (T1.1) instead of a tab panel in one page, but they still show the same two-segment
// breadcrumb: the classroom name (links to Overview) and its section (plain, last),
// per DEC-14.
func classroomCrumbs(room types.Classroom) []ui.Crumb {
	return []ui.Crumb{
		{Label: room.ClassroomName, Href: fmt.Sprintf("/classroom?classroom_id=%s", room.ClassroomID)},
		{Label: room.Section},
	}
}

templ Overview(p layout.Page, room types.Classroom) {
	@layout.Base(p) {
		<!-- No sidebar column here anymore - layout.Base renders one shared ui.Sidebar for
		     every authenticated page now (T1.4 gives it real Active-state navigation, so
		     T1.1's temporary link row is gone), this page just fills the remaining width
		     (see FE-11, D4). -->
		<div class="w-full min-h-full bg-base-300 justify-center gap-4 overflow-x-auto">
			@ui.PageHeader(ui.Header{Crumbs: classroomCrumbs(room), Title: room.ClassroomName, Subtitle: room.Description})
			<!-- Interim Overview: just links to the other three sections. T4.7 replaces this
			     grid with the real summary (C3: student count, quiz average, students per
			     world, flagged count, Needs attention). -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 px-4 pb-4">
				<a href={ templ.URL(fmt.Sprintf("/classroom/minigames?classroom_id=%s", room.ClassroomID)) } class="card bg-base-200 hover:bg-base-100">
					<div class="card-body items-center text-center">
						<i class="fa-solid fa-gamepad fa-2xl" aria-hidden="true"></i>
						<h2 class="card-title">Minigames</h2>
						<p class="text-sm opacity-70">Edit questions and view per-scene statistics.</p>
					</div>
				</a>
				<a href={ templ.URL(fmt.Sprintf("/classroom/students?classroom_id=%s", room.ClassroomID)) } class="card bg-base-200 hover:bg-base-100">
					<div class="card-body items-center text-center">
						<i class="fa-solid fa-users fa-2xl" aria-hidden="true"></i>
						<h2 class="card-title">Students</h2>
						<p class="text-sm opacity-70">Manage who's enrolled in this classroom.</p>
					</div>
				</a>
				<a href={ templ.URL(fmt.Sprintf("/classroom/statistics?classroom_id=%s", room.ClassroomID)) } class="card bg-base-200 hover:bg-base-100">
					<div class="card-body items-center text-center">
						<i class="fa-solid fa-chart-simple fa-2xl" aria-hidden="true"></i>
						<h2 class="card-title">Statistics</h2>
						<p class="text-sm opacity-70">See how students are doing across every scene.</p>
					</div>
				</a>
			</div>
		</div>
	}
}

// kindLabel is the scene-card Kind badge's display text (01 §1c: "Fractions"/"Worded"/
// "Quiz"), distinct from the lowercase types.MinigameKind values used internally for
// dispatch (e.g. minigameKinds in handler/minigame.go).
func kindLabel(k types.MinigameKind) string {
	switch k {
	case types.KindWorded:
		return "Worded"
	case types.KindQuiz:
		return "Quiz"
	default:
		return "Fractions"
	}
}

templ Minigames(p layout.Page, room types.Classroom) {
	@layout.Base(p) {
		<div class="w-full min-h-full bg-base-300 justify-center gap-4 overflow-x-auto">
			@ui.PageHeader(ui.Header{
				Crumbs:   classroomCrumbs(room),
				Title:    "Minigames",
				Subtitle: "Edit the questions students see in each scene, and check how the class is doing.",
			}) {
				<!-- Client-side only (see public/js/index.js): toggles `hidden` on the
				     [data-world] blocks below, so the world filter needs no server round trip
				     (01 §1c). -->
				<div class="join">
					<button type="button" class="btn btn-sm join-item btn-active" data-world-filter="all">All worlds</button>
					<button type="button" class="btn btn-sm join-item" data-world-filter="1">World 1</button>
					<button type="button" class="btn btn-sm join-item" data-world-filter="2">World 2</button>
					<button type="button" class="btn btn-sm join-item" data-world-filter="3">World 3</button>
				</div>
			}
			<div class="flex flex-col gap-5 px-4 pb-4">
				for _, world := range types.Worlds {
					<div data-world={ fmt.Sprint(world.Number) } class="flex flex-col gap-2.5">
						<div class="flex items-baseline gap-2.5">
							<span class="text-base font-bold">World { fmt.Sprint(world.Number) } · { world.Topic }</span>
							<span class="text-[12.5px] opacity-60">{ fmt.Sprint(len(world.Scenes)) } scenes</span>
							<button type="button" aria-label="About this world" data-tip={ world.Intro } class="tooltip opacity-60 hover:opacity-100">
								<i class="fa-solid fa-circle-info text-xs" aria-hidden="true"></i>
							</button>
						</div>
						<div class="grid grid-cols-6 gap-3">
							for _, scene := range world.Scenes {
								<div class="bg-base-100 rounded-box border border-base-content/10 overflow-hidden flex flex-col">
									<div class="relative h-[104px] bg-base-content">
										<img src={ scene.Image } alt={ scene.Alt } class="w-full h-full object-cover object-[center_35%] [image-rendering:pixelated]" />
										<span class="absolute left-2 top-2 px-[7px] py-0.5 rounded-box bg-base-100 text-[11px] font-bold">{ kindLabel(scene.Kind) }</span>
									</div>
									<div class="p-2.5 flex flex-col gap-2 flex-1">
										<span class="text-[13px] font-bold leading-tight min-h-8 line-clamp-2">{ scene.Name }</span>
										<!-- Question count and class accuracy fill in with T4.8 - this task is
										     the layout only (see 02 §C4, "New data" in the design handoff). -->
										<div class="flex flex-col gap-0.5 text-[11.5px] opacity-70 min-h-[28px]"></div>
										<div class="flex gap-1.5 mt-auto">
											<a href={ templ.URL(fmt.Sprintf("/minigame?minigameID=%d&classroomID=%s", scene.MinigameID, room.ClassroomID)) } class="btn btn-primary btn-sm flex-1">Edit</a>
											<a href={ templ.URL(fmt.Sprintf("/classroom/statistics?classroom_id=%s&minigameID=%d", room.ClassroomID, scene.MinigameID)) } aria-label="View statistics" class="btn btn-sm w-[34px] px-0">
												<i class="fa-solid fa-chart-column" aria-hidden="true"></i>
											</a>
										</div>
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>
		</div>
	}
}

// Students' actual markup is StudentsPage, in students.templ (T2.2) - it grew past a
// one-liner (the restyled table, its row-loading fragment, and the add-students
// modal).
templ Students(p layout.Page, room types.Classroom) {
	@StudentsPage(p, room)
}

templ AddStudentsForm(classroomID string) {
<dialog id="modal_add_students" class="modal">
	<!-- max-h + flex-col keeps Cancel/Add always in view: the long student list scrolls
	     inside its own flex-1 region instead of pushing the action row past the bottom
	     of the viewport, which is what the checkbox-hack version did (see FE-43). -->
	<div class="modal-box w-full max-h-[80vh] flex flex-col min-h-0">
		<h3 class="text-lg font-bold">Add Students</h3>
		<form id="add-students-form" hx-post="/addstudents" hx-swap="outerHTML" class="flex flex-col flex-1 min-h-0">
			<input type="hidden" name="classroomID" value={ classroomID } />
			<label class="label cursor-pointer justify-start gap-2 w-fit">
				<input type="checkbox" id="select-all" class="checkbox"/> Select All
			</label>
			<div class="overflow-y-auto flex-1 min-h-0">
				<table class="table table-zebra text-xl">
					<!-- head -->
					<thead>
						<tr>
							<th></th>
							<th></th>
						</tr>
					</thead>
					<tbody id="getunenrolledstudents">
						<tr><td colspan="2" class="text-center"><span class="loading loading-spinner" aria-label="Loading"></span></td></tr>
					</tbody>
				</table>
			</div>
		</form>
		<div class="modal-action">
			<button type="button" class="btn" data-modal-close>Cancel</button>
			<button type="submit" form="add-students-form" class="btn btn-secondary">Add</button>
		</div>
	</div>
	<form method="dialog" class="modal-backdrop">
		<button>close</button>
	</form>
</dialog>
}
