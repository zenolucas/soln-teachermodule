package classroom

import "soln-teachermodule/view/layout"
import "soln-teachermodule/types"
import "fmt"

// tab keeps the teacher on the tab they were on across a full-page reload/redirect
// (e.g. after adding students) instead of always resetting to Overview (see FE-08).
// room carries the classroom's name/section/description purely for display (see
// FE-12 - previously the page showed only tabs, with the classroom's name visible
// nowhere except the sidebar list). classroomID is passed separately, rather than
// read off room, since every link below already builds its URL from it.
templ Classroom(classroomID string, tab string, room types.Classroom) {
@layout.App(true, false, fmt.Sprintf("%s · Sol'n Teacher Portal", room.ClassroomName)) {
<!-- The navbar is h-20 (5rem/80px), not 65px - see the same note in home/index.templ (FE-04). -->
<div class="flex w-full h-[calc(100vh-5rem)]">
	<div class="w-1/4 bg-neutral flex flex-col overflow-x-auto">
		<a href="/home" class="btn btn btn-ghost w-full text-white text-left justify-start h-16 mt-2"><i
				class="fa-solid fa-house fa-2xl ml-6" style="color: #ffffff;"></i>Home</a>
		<div class="divider my-0"></div>
		<div class="btn btn-wide no-animation btn-ghost w-full text-white text-left justify-start"> <i
				class="fa-solid fa-school fa-2xl ml-6" style="color: #ffffff;"></i>Classrooms</div>

		<div class="flex flex-wrap w-full text-white" hx-get="getclassrooms_menu" hx-trigger="load" hx-target="this">
			<div class="flex justify-center w-full p-4"><span class="loading loading-spinner" aria-label="Loading"></span></div>
		</div>
	</div>
	<div class="w-3/4 bg-base-300 justify-center gap-4 overflow-x-auto">
		<div class="px-4 pt-4">
			<h2 class="text-2xl font-bold">{ room.ClassroomName } &mdash; Section { room.Section }</h2>
			if len(room.Description) > 0 {
				<p class="text-sm opacity-70">{ room.Description }</p>
			}
		</div>
		<div role="tablist" class="tabs tabs-bordered tabs-lg mx-1">
			<input type="radio" name="my_tabs_1" role="tab" class="tab" aria-label="Overview" checked?={ tab == "" || tab == "overview" } />
			<div role="tabpanel" class="tab-content p-10">
				<div class="hero bg-base-200">
					<div class="hero-content flex-col lg:flex-row">
						<div>
						<h1 class="text-5xl font-bold">Welcome to the</h1>
						<h1 class="text-5xl font-bold">Sol'n Teacher Portal</h1>
						<p class="py-6 text-2xl">
							Sol’n is a pixel-based game designed to be a supplementary tool to teach Grade 6 students at Saint Louis University Basic Education School fundamental Math concepts, starting with fractions.
							The game aims to enhance students' interest and deepen their understanding of the subject. 
						</p>
						<p class="text-2xl mt-8">
							We thank you for taking the time to be a part of this project!
						</p>
						</div>
						<img src="/public/images/bg/lighthouse.png" alt="" width="544" height="353" class="rounded-lg mb-8" />
					</div>
				</div>
				<div class="hero bg-base-200 mt-8">
					<div class="hero-content flex-col lg:flex-row">
						<div>
							<h1 class="text-5xl font-bold">Fraction Minigames</h1>
							<p class="py-6 text-2xl">
								Characters throughout the world present students with minigames related to fractions. 
								You can modify the questions inside these minigames in the minigames tab.
							</p>
						</div>
						<img src="/public/images/bg/fraction-addition.gif" alt="" width="544" height="353" class="rounded-lg mb-8" />
					</div>
				</div>
				<div class="hero bg-base-200 mt-8">
					<div class="hero-content flex-col lg:flex-row">
						<div>
							<h1 class="text-5xl font-bold">Quizzes (Boss Levels)</h1>
							<p class="py-6 text-2xl">
								At the end of the world there is a boss level which simulates a multiple choice test. The game contains 3 boss levels (one in each world). You can edit the quiz questions in the Minigames tab.
							</p>
						</div>
						<img src="/public/images/bg/quiz.gif" alt="" width="544" height="353" class="rounded-lg mb-8" />
					</div>
				</div>
				<div class="hero bg-base-200 mt-8">
					<div class="hero-content flex-col lg:flex-row">
						<div>
							<h1 class="text-5xl font-bold">View Statistics</h1>
							<p class="py-6 text-2xl">
								When the student is connected to the network, their responses are recorded and can be viewed as statistics in the Minigames tab.
							</p>
						</div>
						<img src="/public/images/bg/statistics.png" alt="" width="544" height="353" class="rounded-lg mb-8" />
					</div>
				</div>
			</div>
			<input type="radio" name="my_tabs_1" role="tab" class="tab" aria-label="Minigames" checked?={ tab == "minigames" } />
			<div role="tabpanel" class="tab-content p-10">
				<!-- One Go slice (types.Worlds/types.Scene) replaces what used to be these
				     12 copy-pasted hero blocks, one per scene (see FE-13). -->
				for _, world := range types.Worlds {
					<h1 class="text-5xl font-bold">{ world.Title }</h1>
					<p class="py-6 text-xl">{ world.Intro }</p>
					for _, scene := range world.Scenes {
						<div class="hero bg-base-200 mb-4">
							<div class="hero-content flex-col lg:flex-row">
								<img src={ scene.Image } alt={ scene.Alt }
									class="max-w-sm rounded-lg shadow-2xl" />
								<div>
									<h1 class="text-2xl font-bold">{ scene.Name }</h1>
									<p class="py-6 text-xl">{ scene.Blurb }</p>
									<a href={ templ.URL(fmt.Sprintf("/minigame?minigameID=%d&classroomID=%s", scene.MinigameID, classroomID))} class="btn btn-primary text-white">Edit Questions</a>
									<a href={ templ.URL(fmt.Sprintf("%s?minigameID=%d&classroomID=%s", scene.StatsPath(), scene.MinigameID, classroomID))} class="btn btn-primary text-white">View Statistics</a>
								</div>
							</div>
						</div>
					}
				}
			</div>
			<input type="radio" name="my_tabs_1" role="tab" class="tab" aria-label="Students" checked?={ tab == "students" } />
			<div role="tabpanel" class="tab-content p-10">
				<div class="overflow-x-auto">
					<!-- get unenrolled students for add students -->
					<form hx-post="/unenrolledstudents" hx-trigger="load" hx-swap="outerHTML"
						hx-target="#getunenrolledstudents">
						<input type="hidden" name="classroomID" value={ classroomID } />
					</form>

					<div class="flex justify-center">
						<button type="button" class="btn btn-primary text-white" data-modal-open="modal_add_students">Add Students</button>
					</div>
					<table class="table table-zebra text-xl">
						<thead>
							<tr>
								<th></th>
								<th class="text-xl">Name</th>
								<th></th>
							</tr>
						</thead>
					<!-- get enrolled students -->
						<form hx-post="/students" hx-trigger="load" hx-swap="outerHTML" hx-target="#getstudents">
							<input type="hidden" name="classroomID" value={ classroomID } />
						</form>
							<tbody id="getstudents">
								<tr><td colspan="3" class="text-center"><span class="loading loading-spinner" aria-label="Loading"></span></td></tr>
							</tbody>
					</table>
				</div>
				@AddStudentsForm(classroomID)
			</div>
		</div>
	</div>
</div>
}
}

templ AddStudentsForm(classroomID string) {
<dialog id="modal_add_students" class="modal">
	<!-- max-h + flex-col keeps Cancel/Add always in view: the long student list scrolls
	     inside its own flex-1 region instead of pushing the action row past the bottom
	     of the viewport, which is what the checkbox-hack version did (see FE-43). -->
	<div class="modal-box w-full max-h-[80vh] flex flex-col min-h-0">
		<h3 class="text-lg font-bold">Add Students</h3>
		<form id="add-students-form" hx-post="/addstudents" hx-swap="outerHTML" class="flex flex-col flex-1 min-h-0">
			<input type="hidden" name="classroomID" value={ classroomID } />
			<label class="label cursor-pointer justify-start gap-2 w-fit">
				<input type="checkbox" id="select-all" class="checkbox"/> Select All
			</label>
			<div class="overflow-y-auto flex-1 min-h-0">
				<table class="table table-zebra text-xl">
					<!-- head -->
					<thead>
						<tr>
							<th></th>
							<th></th>
						</tr>
					</thead>
					<tbody id="getunenrolledstudents">
						<tr><td colspan="2" class="text-center"><span class="loading loading-spinner" aria-label="Loading"></span></td></tr>
					</tbody>
				</table>
			</div>
		</form>
		<div class="modal-action">
			<button type="button" class="btn" data-modal-close>Cancel</button>
			<button type="submit" form="add-students-form" class="btn btn-secondary">Add</button>
		</div>
	</div>
	<form method="dialog" class="modal-backdrop">
		<button>close</button>
	</form>
</dialog>
}