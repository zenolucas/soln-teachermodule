package layout

import "soln-teachermodule/view/ui"

// title is the full <title> text for the page (see FE-17 - every page previously
// shared the one hardcoded "Sol'n Teacher Portal" title, which makes browser tabs and
// history indistinguishable when several are open).
templ App(nav bool, create bool, title string) {
<!DOCTYPE html>
<!-- data-theme intentionally omitted: tailwind.config.js only ever compiles the nord
     theme (see D2), so an "emerald" attribute here did nothing but claim a theme that
     was never actually served. -->
<html lang="en" class="bg-base-300">

<head>
	<title>{ title }</title>
	<link rel="icon" type="image/x-icon" href="/public/images/assets/chip-favicon.png" />

	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="stylesheet" href="/public/styles.css" />
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"
		integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
	<script src="https://unpkg.com/htmx.org@1.9.9" defer></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="/public/js/index.js" defer></script>

</head>

<body class="antialiased">
	if nav {
	@ui.Navigation(create)
	}
	{ children... }
</body>

</html>
}