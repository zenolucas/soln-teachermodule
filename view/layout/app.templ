package layout

import "soln-teachermodule/view/ui"

// TeacherNav is the shell's display identity for the signed-in teacher (greeting,
// sidebar footer, ...). Populated by handler.pageFor from T0.4 on.
type TeacherNav struct {
	DisplayName string
}

// Page replaces App's positional bool/bool/string parameters (nav, charts, title) with
// one struct, so a caller can't accidentally swap the two bools, and so the revamp's
// later tasks (sidebar Active state, classroom-scoped breadcrumbs, the teacher's name)
// have somewhere to add fields without changing every call site's signature again.
type Page struct {
	Title       string
	Charts      bool
	Shell       bool   // false for landing/login/register
	Active      string // "home"|"overview"|"minigames"|"students"|"stats"|"about"|""
	ClassroomID string // "" when not classroom-scoped
	Teacher     TeacherNav
}

// Base renders the page shell. title is the full <title> text (see FE-17 - every page
// previously shared the one hardcoded "Sol'n Teacher Portal" title, which makes browser
// tabs and history indistinguishable when several are open). Charts loads Chart.js -
// only the statistics pages that actually render a canvas[data-chart-url] need it (see
// FE-50); every other page was paying for an unused ~200KB download, including the
// login page. Shell also now controls the shared sidebar (see FE-11, D4) - every page
// that shows the navbar gets the same drawer/sidebar shell, so there's no separate flag
// for it.
templ Base(p Page) {
<!DOCTYPE html>
<!-- data-theme intentionally omitted: tailwind.config.js only ever compiles the nord
     theme (see D2), so an "emerald" attribute here did nothing but claim a theme that
     was never actually served. -->
<html lang="en" class="bg-base-300">

<head>
	<title>{ p.Title }</title>
	<link rel="icon" type="image/x-icon" href="/public/images/assets/chip-favicon.png" />

	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="stylesheet" href="/public/styles.css" />
	<!-- htmx, Chart.js and Font Awesome are vendored under public/vendor/ (go:embed'd
	     with everything else in public/) instead of loaded from a CDN - a school LAN
	     with flaky or filtered internet access previously meant every page load could
	     silently lose htmx entirely, and Chart.js was loaded unversioned, so a new
	     upstream major release could break every stats page with no code change on our
	     side at all (see D3). jQuery was dropped outright: unused anywhere in the app. -->
	<script src="/public/vendor/htmx.min.js" defer></script>
	<script src="/public/vendor/fontawesome.min.js" defer></script>
	if p.Charts {
	<script src="/public/vendor/chart.min.js" defer></script>
	}
	<script src="/public/js/index.js" defer></script>

</head>

<body class="antialiased group/shell">
	<!-- Must run synchronously, before first paint, and be the first thing in <body> -
	     an inline script (no src) blocks the parser right here, so document.body
	     already has the right data-sidebar attribute by the time the sidebar itself is
	     parsed and styled, with no flash of the wrong (expanded, then collapsed) state
	     (DEC-1). try/catch: a private-browsing tab or a blocked/full localStorage must
	     not break the page - it just falls back to the width check every time. -->
	<script>
		try {
			var s = localStorage.getItem('soln.sidebar');
			if (s !== 'collapsed' && s !== 'expanded') {
				s = window.innerWidth < 1200 ? 'collapsed' : 'expanded';
			}
			document.body.dataset.sidebar = s;
		} catch (e) {}
	</script>
	if p.Shell {
	<!-- The daisyUI drawer + navbar (FE-10, FE-11, D4) are gone - the sidebar is
	     always visible at this size, since mobile is out of scope (DEC-1). -->
	<div class="flex h-screen">
		@ui.Sidebar(p.Active, p.ClassroomID, p.Teacher.DisplayName)
		<main class="flex-1 min-w-0 overflow-y-auto bg-base-300">
			{ children... }
		</main>
	</div>
	<!-- Rendered once here, not by each page, so the sidebar "+" and the /home empty
	     state can open the same dialog by id from anywhere (DEC-2). -->
	@ui.CreateClassForm(ui.CreateParams{}, ui.CreateErrors{})
	} else {
	{ children... }
	}
</body>

</html>
}
