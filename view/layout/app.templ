package layout

import "soln-teachermodule/view/ui"

// title is the full <title> text for the page (see FE-17 - every page previously
// shared the one hardcoded "Sol'n Teacher Portal" title, which makes browser tabs and
// history indistinguishable when several are open). charts loads Chart.js - only the
// statistics pages that actually render a canvas[data-chart-url] need it (see FE-50);
// every other page was paying for an unused ~200KB download, including the login page.
// nav also now controls the shared sidebar (see FE-11, D4) - every page that shows the
// navbar gets the same drawer/sidebar shell, so there's no separate flag for it.
templ App(nav bool, charts bool, title string) {
<!DOCTYPE html>
<!-- data-theme intentionally omitted: tailwind.config.js only ever compiles the nord
     theme (see D2), so an "emerald" attribute here did nothing but claim a theme that
     was never actually served. -->
<html lang="en" class="bg-base-300">

<head>
	<title>{ title }</title>
	<link rel="icon" type="image/x-icon" href="/public/images/assets/chip-favicon.png" />

	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="stylesheet" href="/public/styles.css" />
	<!-- htmx, Chart.js and Font Awesome are vendored under public/vendor/ (go:embed'd
	     with everything else in public/) instead of loaded from a CDN - a school LAN
	     with flaky or filtered internet access previously meant every page load could
	     silently lose htmx entirely, and Chart.js was loaded unversioned, so a new
	     upstream major release could break every stats page with no code change on our
	     side at all (see D3). jQuery was dropped outright: unused anywhere in the app. -->
	<script src="/public/vendor/htmx.min.js" defer></script>
	<script src="/public/vendor/fontawesome.min.js" defer></script>
	if charts {
	<script src="/public/vendor/chart.min.js" defer></script>
	}
	<script src="/public/js/index.js" defer></script>

</head>

<body class="antialiased">
	if nav {
	@ui.Navigation()
	<!-- lg:drawer-open keeps the sidebar permanently visible (not just toggleable) at
	     the lg breakpoint and above - below that it's off-canvas, opened via the
	     hamburger's for="app-drawer" label and closed via the overlay or its own
	     toggle (see FE-10, FE-11, D4). The navbar itself stays outside the drawer so
	     it still spans the full width above the sidebar, matching the layout every
	     page already assumed (see FE-04's h-[calc(100vh-5rem)] note). -->
	<div class="drawer lg:drawer-open">
		<input id="app-drawer" type="checkbox" class="drawer-toggle" />
		<div class="drawer-content overflow-x-auto">
			{ children... }
		</div>
		<div class="drawer-side z-30 h-[calc(100vh-5rem)]">
			<label for="app-drawer" aria-label="Close menu" class="drawer-overlay"></label>
			@ui.Sidebar()
		</div>
	</div>
	} else {
	{ children... }
	}
</body>

</html>
}