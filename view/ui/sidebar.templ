package ui

import "fmt"

// Sidebar takes the pieces it needs off layout.Page (active, classroomID, the
// teacher's display name) rather than layout.Page itself - layout already imports ui
// (for CreateClassForm and this component), so ui importing layout back for the Page
// type would be an import cycle.
//
// It's rendered once by layout.Base for every Shell page (see FE-11, D4), replacing
// the old daisyUI drawer + navbar with the fixed 248px sidebar from 01 §Shell. Only the
// expanded state is implemented here - collapsing to a 64px rail is T1.6, and the
// classroom list itself still renders HandleGetClassroomsMenu's old markup until T1.5,
// so it looks plain for now (see 01 §Shell items 4-5).
templ Sidebar(active string, classroomID string, teacherName string) {
	<aside class="w-[248px] shrink-0 bg-base-content text-base-300 flex flex-col h-screen">
		<div class="h-16 shrink-0 flex items-center gap-2.5 px-[18px] border-b border-polar1">
			<img src="/public/images/assets/chip-favicon.png" alt="" class="w-[30px] h-[30px] [image-rendering:pixelated]" />
			<div class="flex flex-col leading-tight">
				<span class="font-bold text-base text-base-100">Sol'n</span>
				<span class="text-[11.5px] opacity-75">Teacher Portal</span>
			</div>
			<!-- Renders but does nothing yet - the collapse behaviour itself is T1.6. -->
			<button type="button" data-sidebar-toggle aria-label="Collapse sidebar" class="ml-auto text-[13px] opacity-60 hover:opacity-100">
				<i class="fa-solid fa-angles-left" aria-hidden="true"></i>
			</button>
		</div>
		<nav class="flex-1 flex flex-col gap-0.5 px-2.5 py-3.5 overflow-y-auto">
			<a href="/home" class={ "h-[38px] flex items-center gap-3 px-3 rounded text-sm", templ.KV("bg-primary text-white font-semibold", active == "home") }>
				<i class="fa-solid fa-house w-[18px] text-center" aria-hidden="true"></i>Home
			</a>
			<div class="flex items-center justify-between px-3 pt-[18px] pb-1.5">
				<span class="text-[11px] font-bold tracking-[.08em] opacity-60">CLASSROOMS</span>
				<button type="button" data-modal-open="create-classroom-modal" aria-label="New classroom" class="w-[22px] h-[22px] rounded flex items-center justify-center bg-polar1 text-base-100 text-[11px]">
					<i class="fa-solid fa-plus" aria-hidden="true"></i>
				</button>
			</div>
			<div hx-get={ fmt.Sprintf("/getclassrooms_menu?classroom_id=%s&active=%s", classroomID, active) } hx-trigger="load" hx-target="this">
				<div class="flex justify-center w-full p-4"><span class="loading loading-spinner" aria-label="Loading"></span></div>
			</div>
		</nav>
		<div class="shrink-0 flex items-center gap-2.5 px-4 py-3 border-t border-polar1">
			<img src="/public/images/bg/sample_user.png" alt="" class="w-[34px] h-[34px] rounded-full object-cover bg-base-100" />
			<div class="flex-1 min-w-0 flex flex-col leading-[1.25]">
				<span class="text-[13.5px] font-semibold text-base-100 truncate">{ teacherName }</span>
				<span class="text-[11.5px] opacity-70">Teacher</span>
			</div>
			<a href="/about" aria-label="About Sol'n" class="text-[14px] opacity-80 hover:opacity-100">
				<i class="fa-solid fa-circle-question" aria-hidden="true"></i>
			</a>
			@LogoutForm()
		</div>
	</aside>
}
