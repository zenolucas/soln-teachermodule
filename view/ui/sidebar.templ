package ui

import "fmt"

// Sidebar takes the pieces it needs off layout.Page (active, classroomID, the
// teacher's display name) rather than layout.Page itself - layout already imports ui
// (for CreateClassForm and this component), so ui importing layout back for the Page
// type would be an import cycle.
//
// It's rendered once by layout.Base for every Shell page (see FE-11, D4), replacing
// the old daisyUI drawer + navbar with the fixed 248px sidebar from 01 §Shell.
//
// Both the expanded and collapsed states live in this one tree (DEC-1: there's no
// server-side collapsed/expanded state, so a fragment like the classroom list can't
// know which to render). Elements that only belong to one state are hidden in the
// other with group-data-[sidebar=.../shell: variants, matched against the
// data-sidebar attribute the pre-paint script in layout/app.templ sets on <body>
// before first render - see T1.6.
templ Sidebar(active string, classroomID string, teacherName string) {
	<aside class="w-[248px] group-data-[sidebar=collapsed]/shell:w-16 shrink-0 bg-base-content text-base-300 flex flex-col h-screen">
		<div class="h-16 shrink-0 flex items-center gap-2.5 px-[18px] group-data-[sidebar=collapsed]/shell:px-0 group-data-[sidebar=collapsed]/shell:justify-center border-b border-polar1">
			<img src="/public/images/assets/chip-favicon.png" alt="" class="w-[30px] h-[30px] shrink-0 [image-rendering:pixelated]" />
			<div class="flex flex-col leading-tight group-data-[sidebar=collapsed]/shell:hidden">
				<span class="font-bold text-base text-base-100">Sol'n</span>
				<span class="text-[11.5px] opacity-75">Teacher Portal</span>
			</div>
			<button type="button" data-sidebar-toggle aria-label="Collapse sidebar" data-tip="Collapse sidebar"
				class="tooltip tooltip-right ml-auto text-[13px] opacity-60 hover:opacity-100 group-data-[sidebar=collapsed]/shell:hidden">
				<i class="fa-solid fa-angles-left" aria-hidden="true"></i>
			</button>
		</div>
		<nav class="flex-1 flex flex-col gap-0.5 px-2.5 py-3.5 overflow-y-auto group-data-[sidebar=collapsed]/shell:items-center group-data-[sidebar=collapsed]/shell:px-0">
			<a href="/home" aria-label="Home" data-tip="Home"
				class={
					"h-[38px] group-data-[sidebar=collapsed]/shell:w-10 group-data-[sidebar=collapsed]/shell:h-10 group-data-[sidebar=collapsed]/shell:justify-center group-data-[sidebar=collapsed]/shell:tooltip group-data-[sidebar=collapsed]/shell:tooltip-right flex items-center gap-3 px-3 group-data-[sidebar=collapsed]/shell:px-0 rounded text-sm",
					templ.KV("bg-primary text-white font-semibold", active == "home"),
				}>
				<i class="fa-solid fa-house w-[18px] text-center" aria-hidden="true"></i>
				<span class="group-data-[sidebar=collapsed]/shell:hidden">Home</span>
			</a>
			<div class="flex items-center justify-between px-3 pt-[18px] pb-1.5 group-data-[sidebar=collapsed]/shell:hidden">
				<span class="text-[11px] font-bold tracking-[.08em] opacity-60">CLASSROOMS</span>
				<button type="button" data-modal-open="create-classroom-modal" aria-label="New classroom" class="w-[22px] h-[22px] rounded flex items-center justify-center bg-polar1 text-base-100 text-[11px]">
					<i class="fa-solid fa-plus" aria-hidden="true"></i>
				</button>
			</div>
			<div class="hidden group-data-[sidebar=collapsed]/shell:block w-7 h-px bg-polar1 my-1.5"></div>
			<div class="contents" hx-get={ fmt.Sprintf("/getclassrooms_menu?classroom_id=%s&active=%s", classroomID, active) } hx-trigger="load" hx-target="this">
				<div class="flex justify-center w-full p-4"><span class="loading loading-spinner" aria-label="Loading"></span></div>
			</div>
			<button type="button" data-modal-open="create-classroom-modal" aria-label="New classroom" data-tip="New classroom"
				class="hidden group-data-[sidebar=collapsed]/shell:flex tooltip tooltip-right w-10 h-10 rounded items-center justify-center text-xs border border-dashed border-neutral">
				<i class="fa-solid fa-plus" aria-hidden="true"></i>
			</button>
		</nav>
		<div class="shrink-0 flex items-center gap-2.5 px-4 py-3 group-data-[sidebar=collapsed]/shell:flex-col group-data-[sidebar=collapsed]/shell:gap-3 group-data-[sidebar=collapsed]/shell:px-0 border-t border-polar1">
			<button type="button" data-sidebar-toggle aria-label="Expand sidebar" data-tip="Expand sidebar"
				class="hidden group-data-[sidebar=collapsed]/shell:block tooltip tooltip-right text-[13px] opacity-60 hover:opacity-100">
				<i class="fa-solid fa-angles-right" aria-hidden="true"></i>
			</button>
			<img src="/public/images/bg/sample_user.png" alt="" class="w-[34px] h-[34px] shrink-0 rounded-full object-cover bg-base-100" />
			<div class="flex-1 min-w-0 flex flex-col leading-[1.25] group-data-[sidebar=collapsed]/shell:hidden">
				<span class="text-[13.5px] font-semibold text-base-100 truncate">{ teacherName }</span>
				<span class="text-[11.5px] opacity-70">Teacher</span>
			</div>
			<a href="/about" aria-label="About Sol'n" class="text-[14px] opacity-80 hover:opacity-100 group-data-[sidebar=collapsed]/shell:hidden">
				<i class="fa-solid fa-circle-question" aria-hidden="true"></i>
			</a>
			<div class="group-data-[sidebar=collapsed]/shell:hidden">
				@LogoutForm()
			</div>
		</div>
	</aside>
}
