package ui

// LogoutForm used to nest a <li> inside its <form>, which itself sat inside the
// caller's own <li> - li>form>li is invalid list markup and confuses screen readers
// (see FE-16). It's now a plain icon button in the sidebar footer (see sidebar.templ,
// 01 §Shell item 6), submitting the same POST /logout it always did.
templ LogoutForm() {
	<form method="POST" action="/logout">
		<button type="submit" aria-label="Log out" class="text-[14px] opacity-80 hover:opacity-100">
			<i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
		</button>
	</form>
}
