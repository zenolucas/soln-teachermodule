package home

import (
	"fmt"
	"soln-teachermodule/view/layout"
)

templ Index() {
@layout.App(true, true, "Home · Sol'n Teacher Portal") {
<!-- The navbar is h-20 (5rem/80px), not 65px - the mismatch was making this pane 15px
     taller than the viewport, so both the window and the pane scrolled (see FE-04). -->
<div class="flex w-full h-[calc(100vh-5rem)]">
	<div class="w-1/4 bg-neutral flex">
	</div>
	<div class="w-3/4 bg-base-300 justify-center gap-4">
		<div class="flex flex-wrap w-full text-white" hx-get="getclassrooms" hx-trigger="load" hx-target="this">
			<div class="flex justify-center w-full p-8"><span class="loading loading-spinner loading-lg" aria-label="Loading"></span></div>
		</div>
		@CreateClassForm(CreateParams{}, CreateErrors{})
	</div>
</div>

}
}

type CreateParams struct {
Classname string
Section string
Description string
}

type CreateErrors struct {
ErrorMessage string
}

templ CreateClassForm(data CreateParams, errors CreateErrors) {
<!-- data-autoopen re-shows this after an htmx swap re-renders it with an error, so the
     modal stays open instead of silently closing on the client with the teacher's
     input discarded (FE-02); see solnOpenPendingModals in public/js/index.js. -->
<dialog id="my_modal_6" class="modal" data-autoopen={ fmt.Sprint(len(errors.ErrorMessage) > 0) }>
	<div class="modal-box">
		<h3 class="text-lg font-bold">Create Classroom</h3>
		if len(errors.ErrorMessage) > 0 {
			<div role="alert" class="alert alert-error mt-4">
				<span>{ errors.ErrorMessage }</span>
			</div>
		}
		<form id="create-classroom-form" hx-post="/createclassroom" hx-swap="outerHTML" hx-target="#my_modal_6">
			<label class="form-control w-full max-w-s">
				<div class="label">
					<span class="label-text">Class name</span>
				</div>
				<input type="text" name="classname" value={ data.Classname } placeholder="Type here" required maxlength="100" class="input input-bordered w-full" />
				<div class="label">
					<span class="label-text">Section</span>
				</div>
				<input type="text" name="section" value={ data.Section } placeholder="Type here" required maxlength="100" class="input input-bordered w-full" />
				<div class="label">
					<span class="label-text">Description</span>
				</div>
				<textarea name="description" placeholder="Type here" maxlength="200" class="textarea textarea-bordered w-full">{ data.Description }</textarea>
			</label>
		</form>
		<div class="modal-action">
			<button type="button" class="btn" data-modal-close>Cancel</button>
			<button type="submit" form="create-classroom-form" class="btn btn-secondary">Create</button>
		</div>
	</div>
	<form method="dialog" class="modal-backdrop">
		<button>close</button>
	</form>
</dialog>
}