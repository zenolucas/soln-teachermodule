package minigame

import (
     "soln-teachermodule/view/layout"
     "soln-teachermodule/view/ui"
)


templ Fractions(minigameID string, classroomID string, classroomName string, sceneName string) {
@layout.App(true, false, "Simple Fraction Questions · Sol'n Teacher Portal") {
@ui.Breadcrumb(classroomID, classroomName, sceneName, "Edit Questions")
<div>
</div>
<form hx-post="/getfractions" hx-trigger="load" hx-swap="outerHTML" hx-target="#questions-container">
     <input type="hidden" name="minigameID" value={ minigameID } />
     <input type="hidden" name="classroomID" value={ classroomID } />
</form>
<div class="flex justify-center items-center flex-col w-full h-140 mt-8">
     <h1 class="text-5xl font-bold">Simple Fraction Questions</h1>
     <div class="flex justify-center mt-4 space-x-4">
          <button type="button" class="btn btn-primary text-white" data-modal-open="my_modal_6">Add Question</button>
     </div>
     <div id="questions-container" class="mb-4">
     <div class="flex justify-center w-full p-8"><span class="loading loading-spinner loading-lg" aria-label="Loading"></span></div>
     </div>
</div>

@CreateFractionQuestionForm(FractionQuestionParams{}, minigameID, classroomID)
}
}

templ Worded(minigameID string, classroomID string, classroomName string, sceneName string) {
@layout.App(true, false, "Worded Fraction Questions · Sol'n Teacher Portal") {
@ui.Breadcrumb(classroomID, classroomName, sceneName, "Edit Questions")
<form hx-post="/getwordedquestions" hx-trigger="load" hx-swap="outerHTML" hx-target="#questions-container">
     <input type="hidden" name="minigameID" value={ minigameID } />
     <input type="hidden" name="classroomID" value={ classroomID } />
</form>
<div class="flex justify-center items-center flex-col w-full h-140 mt-8">
     <h1 class="text-5xl font-bold">Worded Fraction Questions</h1>
     <button type="button" class="btn btn-primary text-white" data-modal-open="my_modal_6">Add Question</button>
     <div id="questions-container">
     <div class="flex justify-center w-full p-8"><span class="loading loading-spinner loading-lg" aria-label="Loading"></span></div>
     </div>
</div>

@CreateWordedQuestionForm(WordedQuestionParams{}, minigameID, classroomID)
}
}

templ Quiz(minigameID string, classroomID string, classroomName string, sceneName string) {
@layout.App(true, false, "Quiz Questions · Sol'n Teacher Portal") {
@ui.Breadcrumb(classroomID, classroomName, sceneName, "Edit Questions")
<form hx-post="/getmcquestions" hx-swap="outerHTML" hx-trigger="load" hx-target="#questions-container">
     <input type="hidden" name="minigameID" value={ minigameID } />
     <input type="hidden" name="classroomID" value={ classroomID } />
</form>
<div class="flex justify-center items-center flex-col w-full h-140 mt-8">
     <h1 class="text-5xl font-bold">Quiz Questions (Multiple Choice)</h1>
     <div class="flex justify-center mt-4">
          <button type="button" class="btn btn-primary text-white" data-modal-open="my_modal_6">Add Question</button>
     </div>
     <div id="questions-container">
     <div class="flex justify-center w-full p-8"><span class="loading loading-spinner loading-lg" aria-label="Loading"></span></div>
     </div>
</div>


@CreateMCQuestionForm(QuestionParams{}, minigameID, classroomID)
}
}

type FractionQuestionParams struct {
     Fraction1_Numerator string
     Fraction1_Denominator string
     Fraction2_Numerator string
     Fraction2_Denominator string
}

templ CreateFractionQuestionForm(data FractionQuestionParams, minigameID string, classroomID string) {
     <dialog id="my_modal_6" class="modal">
          <div class="modal-box">
               <h3 class="text-lg font-bold">Add Question</h3>
               <form id="add-fraction-question-form" hx-post="/add/fractionquestions" hx-swap="outerHTML">
                    <input type="hidden" name="minigameID" value={ minigameID } />
                    <input type="hidden" name="classroomID" value={ classroomID } />
                    <label class="form-control w-full max-w-s">
                         <div class="label">
                              <span class="label-text">Fraction 1 Numerator</span>
                         </div>
                         <input type="number" inputmode="numeric" required min="0" name="fraction1_numerator" placeholder="Type here" class="input input-bordered w-full" />
                    </label>
                    <label class="form-control w-full max-w-s">
                         <div class="label">
                              <span class="label-text">Fraction 1 Denominator</span>
                         </div>
                         <input type="number" inputmode="numeric" required min="1" name="fraction1_denominator" placeholder="Type here" class="input input-bordered w-full" />
                    </label>
                    <label class="form-control w-full max-w-s">
                         <div class="label">
                              <span class="label-text">Fraction 2 Numerator</span>
                         </div>
                         <input type="number" inputmode="numeric" required min="0" name="fraction2_numerator" placeholder="Type here" class="input input-bordered w-full" />
                    </label>
                    <label class="form-control w-full max-w-s">
                         <div class="label">
                              <span class="label-text">Fraction 2 Denominator</span>
                         </div>
                         <input type="number" inputmode="numeric" required min="1" name="fraction2_denominator" placeholder="Type here" class="input input-bordered w-full" />
                    </label>
               </form>
               <div class="modal-action">
                    <button type="button" class="btn" data-modal-close>Cancel</button>
                    <button type="submit" form="add-fraction-question-form" class="btn btn-secondary">Add Question</button>
               </div>
          </div>
          <form method="dialog" class="modal-backdrop">
               <button>close</button>
          </form>
     </dialog>
}

type WordedQuestionParams struct {
     Fraction1_Numerator string
     Fraction1_Denominator string
     Fraction2_Numerator string
     Fraction2_Denominator string
}

templ CreateWordedQuestionForm(data WordedQuestionParams, minigameID string, classroomID string) {
     <dialog id="my_modal_6" class="modal">
          <div class="modal-box">
               <h3 class="text-lg font-bold">Add Question</h3>
               <form id="add-worded-question-form" hx-post="/add/wordedquestions" hx-swap="outerHTML">
                    <input type="hidden" name="minigameID" value={ minigameID } />
                    <input type="hidden" name="classroomID" value={ classroomID } />
                    <label class="form-control w-full max-w-s">
                         <div class="label">
                              <span class="label-text">Question Text</span>
                         </div>
                         <input type="text" name="question_text" placeholder="Type here" required maxlength="500" class="input input-bordered w-full" />
                    </label>
                    <label class="form-control w-full max-w-s">
                         <div class="label">
                              <span class="label-text">Fraction 1 Numerator</span>
                         </div>
                         <input type="number" inputmode="numeric" required min="0" name="fraction1_numerator" placeholder="Type here" class="input input-bordered w-full" />
                    </label>
                    <label class="form-control w-full max-w-s">
                         <div class="label">
                              <span class="label-text">Fraction 1 Denominator</span>
                         </div>
                         <input type="number" inputmode="numeric" required min="1" name="fraction1_denominator" placeholder="Type here" class="input input-bordered w-full" />
                    </label>
                    <label class="form-control w-full max-w-s">
                         <div class="label">
                              <span class="label-text">Fraction 2 Numerator</span>
                         </div>
                         <input type="number" inputmode="numeric" required min="0" name="fraction2_numerator" placeholder="Type here" class="input input-bordered w-full" />
                    </label>
                    <label class="form-control w-full max-w-s">
                         <div class="label">
                              <span class="label-text">Fraction 2 Denominator</span>
                         </div>
                         <input type="number" inputmode="numeric" required min="1" name="fraction2_denominator" placeholder="Type here" class="input input-bordered w-full" />
                    </label>
               </form>
               <div class="modal-action">
                    <button type="button" class="btn" data-modal-close>Cancel</button>
                    <button type="submit" form="add-worded-question-form" class="btn btn-secondary">Add Question</button>
               </div>
          </div>
          <form method="dialog" class="modal-backdrop">
               <button>close</button>
          </form>
     </dialog>
}

type QuestionParams struct {
QuestionText string
Option1 string
Option2 string
Option3 string
Option4 string
}

templ CreateMCQuestionForm(data QuestionParams, minigameID string, classroomID string) {
<dialog id="my_modal_6" class="modal">
     <div class="modal-box">
          <h3 class="text-lg font-bold">Add Question</h3>
          <form id="add-mc-question-form" hx-post="/add/mcquestions" hx-swap="outerHTML">
               <input type="hidden" name="minigameID" value={ minigameID } />
               <input type="hidden" name="classroomID" value={ classroomID } />
               <label class="form-control w-full max-w-s">
                    <div class="label">
                         <span class="label-text">Question Text</span>
                    </div>
                    <input type="text" name="question_text" placeholder="Type here" required
                         class="input input-bordered w-full" />
               </label>
               <label class="form-control w-full max-w-s">
                    <div class="label">
                         <span class="label-text">Option 1</span>
                    </div>
                    <input type="text" name="option_1" placeholder="Type here" required maxlength="255" class="input input-bordered w-full" />
               </label>
               <label class="form-control w-full max-w-s">
                    <div class="label">
                         <span class="label-text">Option 2</span>
                    </div>
                    <input type="text" name="option_2" placeholder="Type here" required maxlength="255" class="input input-bordered w-full" />
               </label>
               <label class="form-control w-full max-w-s">
                    <div class="label">
                         <span class="label-text">Option 3</span>
                    </div>
                    <input type="text" name="option_3" placeholder="Type here" required maxlength="255" class="input input-bordered w-full" />
               </label>
               <label class="form-control w-full max-w-s">
                    <div class="label">
                         <span class="label-text">Option 4</span>
                    </div>
                    <input type="text" name="option_4" placeholder="Type here" required maxlength="255" class="input input-bordered w-full" />
               </label>
               <label class="form-control w-full max-w-xs">
                    <div class="label">
                         <span class="label-text">Correct Answer</span>
                    </div>
                    <select name="correct_answer" class="select select-bordered w-full max-w-xs">
                         <option value="option_1">Option 1</option>
                         <option value="option_2">Option 2</option>
                         <option value="option_3">Option 3</option>
                         <option value="option_4">Option 4</option>
                    </select>
               </label>
          </form>
          <div class="modal-action">
               <button type="button" class="btn" data-modal-close>Cancel</button>
               <button type="submit" form="add-mc-question-form" class="btn btn-secondary">Add Question</button>
          </div>
     </div>
     <form method="dialog" class="modal-backdrop">
          <button>close</button>
     </form>
</dialog>
}