package statistics

import (
	"fmt"

	"soln-teachermodule/types"
	"soln-teachermodule/view/layout"
	"soln-teachermodule/view/ui"
)

// flagLabel mirrors handler.FlagLabel's copy - view/statistics can't import handler,
// which already imports this package (the same problem view/classroom's own flagLabel
// solves, T4.10).
func flagLabel(kind types.FlagKind) string {
	switch kind {
	case types.FlagQuizBelow60:
		return "Quiz below 60%"
	case types.FlagLowAccuracy:
		return "Low accuracy"
	default:
		return ""
	}
}

// worldLabelFor is "World N" on a journey tile, but only for the first scene of each
// world (01 §1h) - every other tile in that world gets "".
func worldLabelFor(minigameID int) string {
	for _, w := range types.Worlds {
		if len(w.Scenes) > 0 && w.Scenes[0].MinigameID == minigameID {
			return fmt.Sprintf("World %d", w.Number)
		}
	}
	return ""
}

// tileBadge is a journey tile's 20px status badge (01 §1h's table): background tint
// and icon per state.
func tileBadgeClass(state string) string {
	switch state {
	case "done-pass":
		return "bg-success"
	case "done-fail":
		return "bg-error"
	case "current":
		return "bg-accent"
	default:
		return "bg-base-300"
	}
}

func tileBadgeIcon(state string) string {
	switch state {
	case "done-pass":
		return "fa-solid fa-check"
	case "done-fail":
		return "fa-solid fa-exclamation"
	case "current":
		return "fa-solid fa-play"
	default:
		return "fa-solid fa-lock"
	}
}

// StudentPage is the student scores page (01 §1h): header (avatar, name, current
// scene, flags, Previous/Next), three stats (DEC-24 drops the spec's fourth
// "Longest wrong streak" card), the 12-tile journey, a scene-detail panel that loads
// QuizDetail/FractionDetail (T5.8) on tile click, and the static Minigame attempts
// card. finished is handler.finishedCount(ins.Current, ins.Completed); prevID/nextID
// come from handler.neighbours in the current sort order (DEC-19, carried via sortKey
// on the nav buttons and, eventually, "View scores" links back on the Students page).
templ StudentPage(p layout.Page, classroomID string, room types.Classroom, ins types.StudentInsight, journey []types.JourneyTile, finished int, prevID, nextID, sortKey string, attempts []MinigameAttemptRow) {
	@layout.Base(p) {
		<div class="w-full min-h-full bg-base-300 flex flex-col gap-4 p-4">
			<div class="flex flex-col gap-2.5">
				@ui.Crumbs([]ui.Crumb{
					{Label: room.ClassroomName, Href: fmt.Sprintf("/classroom?classroom_id=%s", classroomID)},
					{Label: "Students", Href: fmt.Sprintf("/classroom/students?classroom_id=%s", classroomID)},
					{Label: fmt.Sprintf("%s %s", ins.Firstname, ins.Lastname)},
				})
				<div class="flex items-center gap-3.5">
					<span class="w-[52px] h-[52px] shrink-0 rounded-full bg-secondary text-base-content flex items-center justify-center text-lg font-bold">
						{ ui.Initials(ins.Firstname, ins.Lastname) }
					</span>
					<div class="flex-1 min-w-0 flex flex-col gap-1">
						<h1 class="text-[22px] font-bold">{ ins.Firstname } { ins.Lastname }</h1>
						<div class="flex items-center gap-2 flex-wrap text-[13px] opacity-70">
							<span>
								if ins.Completed {
									Completed
								} else if scene, ok := types.SceneByID(ins.Current); ok {
									Currently in World { fmt.Sprint(ins.World) } · { scene.Name }
								}
							</span>
							for _, f := range ins.Flags {
								<span class="flex items-center gap-1.5 px-2 py-0.5 rounded-box bg-error/15 text-[11.5px] font-semibold text-base-content">
									<span class="w-[6px] h-[6px] rounded-full bg-error"></span>
									{ flagLabel(f.Kind) }
								</span>
							}
						</div>
					</div>
					<div class="flex gap-1.5">
						@studentNavButton("Previous", "fa-chevron-left", true, prevID, classroomID, sortKey)
						@studentNavButton("Next", "fa-chevron-right", false, nextID, classroomID, sortKey)
					</div>
				</div>
			</div>
			<div class="grid grid-cols-3 gap-3.5">
				<div class={ "bg-base-100 rounded-box border p-4 flex flex-col gap-0.5",
					templ.KV("border-error/45", ins.QuizAvgPct >= 0 && ins.QuizAvgPct < types.PassPct),
					templ.KV("border-base-content/10", ins.QuizAvgPct < 0 || ins.QuizAvgPct >= types.PassPct) }>
					<span class="text-[12.5px] opacity-60">Quiz average</span>
					<span class="text-2xl font-bold">{ ui.Pct(ins.QuizAvgPct) }</span>
				</div>
				<div class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-0.5">
					<span class="text-[12.5px] opacity-60">Minigame accuracy</span>
					<span class="text-2xl font-bold">{ ui.Pct(ins.AccuracyPct) }</span>
				</div>
				<div class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-0.5">
					<span class="text-[12.5px] opacity-60">Scenes finished</span>
					<span class="text-2xl font-bold">
						{ fmt.Sprint(finished) }
						<span class="text-sm font-semibold opacity-60"> / 12</span>
					</span>
				</div>
			</div>
			<div class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-3">
				<span class="text-[15px] font-bold">Journey</span>
				<div class="grid grid-cols-12 gap-2">
					for _, tile := range journey {
						@journeyTile(tile, ins.UserID, classroomID)
					}
				</div>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-[1.15fr_1fr] gap-4">
				<!-- #scene-detail is a plain <div>, swapped with the default innerHTML (not
				     outerHTML) so its id survives every journey-tile click - the same
				     <tbody>-id-loss failure mode T2.2 found still applies to any repeatedly
				     swapped target, table or not. -->
				<div id="scene-detail" class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-2.5 overflow-x-auto">
					if scene, ok := types.SceneByID(ins.Current); ok {
						<form hx-get={ fmt.Sprintf("%s?userID=%s&minigameID=%d&classroomID=%s", scene.StudentStatsPath(), ins.UserID, scene.MinigameID, classroomID) } hx-trigger="load" hx-target="#scene-detail">
						</form>
					}
					<div class="flex justify-center w-full p-8"><span class="loading loading-spinner" aria-label="Loading"></span></div>
				</div>
				@MinigameAttempts(attempts)
			</div>
		</div>
	}
}

templ studentNavButton(label, icon string, iconFirst bool, targetID, classroomID, sortKey string) {
	if targetID == "" {
		<span class="h-[34px] flex items-center gap-1.5 px-3 rounded text-[13px] font-semibold bg-base-200 opacity-40">
			if iconFirst {
				<i class={ fmt.Sprintf("%s text-xs", icon) } aria-hidden="true"></i>
			}
			{ label }
			if !iconFirst {
				<i class={ fmt.Sprintf("%s text-xs", icon) } aria-hidden="true"></i>
			}
		</span>
	} else {
		<a href={ templ.URL(fmt.Sprintf("/student/score?userID=%s&classroomID=%s&sort=%s", targetID, classroomID, sortKey)) } class="h-[34px] flex items-center gap-1.5 px-3 rounded text-[13px] font-semibold bg-base-200">
			if iconFirst {
				<i class={ fmt.Sprintf("%s text-xs", icon) } aria-hidden="true"></i>
			}
			{ label }
			if !iconFirst {
				<i class={ fmt.Sprintf("%s text-xs", icon) } aria-hidden="true"></i>
			}
		</a>
	}
}

templ journeyTile(tile types.JourneyTile, studentID, classroomID string) {
	<div class={ "flex flex-col items-center gap-1.5 min-w-0", templ.KV("opacity-40", tile.State == "locked") }>
		<span class="text-[10.5px] font-bold opacity-60 h-[13px]">{ worldLabelFor(tile.Scene.MinigameID) }</span>
		<button type="button"
			hx-get={ fmt.Sprintf("%s?userID=%s&minigameID=%d&classroomID=%s", tile.Scene.StudentStatsPath(), studentID, tile.Scene.MinigameID, classroomID) }
			hx-target="#scene-detail"
			aria-label={ tile.Scene.Name }
			class={ "relative w-14 h-[68px] rounded shrink-0", templ.KV("ring-[3px] ring-primary", tile.State == "current") }>
			<img src={ tile.Scene.Image } alt="" class="w-full h-full object-cover object-[center_35%] [image-rendering:pixelated] rounded block"/>
			<span class={ "absolute -right-1 -bottom-1 w-5 h-5 rounded-full flex items-center justify-center text-[10px] text-base-content border-2 border-base-100", tileBadgeClass(tile.State) }>
				<i class={ tileBadgeIcon(tile.State) } aria-hidden="true"></i>
			</span>
		</button>
		<span class="text-[11px] leading-tight text-center h-[26px] overflow-hidden line-clamp-2">{ tile.Scene.Name }</span>
		<span class={ "text-xs font-bold", templ.KV("text-error", tile.State == "done-fail") }>{ tile.ScoreText }</span>
	</div>
}

// QuizDetailRow is one quiz question in a student's scene-detail panel (01 §1h):
// Question · Correct · Their answer · ✓/✗. Answer/Correct come straight from
// database.GetStudentQuizStatistics - templ escapes them on render, so a question or
// answer containing "<b>" shows literally rather than getting interpreted as markup.
type QuizDetailRow struct {
	Question string
	Correct  string
	Answer   string
	Right    bool
}

// QuizDetail is the scene-detail panel's content for a quiz scene tile: title + score
// badge, a misconception callout (handler.StudentHint, only when it fires - 02 §B6),
// and the question table, capped to 7 rows with "Show all n questions". The cap is a
// peer-checkbox toggle (same client-only, no-JS technique as
// view/classroom/students.templ's filter pills) rather than an index.js handler,
// since T5.8's file list doesn't touch public/js/index.js.
templ QuizDetail(scene types.Scene, score, total int, hint string, rows []QuizDetailRow) {
	<div class="flex items-center gap-2.5">
		<img src={ scene.Image } alt="" class="w-7 h-[34px] rounded object-cover object-[center_35%] [image-rendering:pixelated]"/>
		<span class="flex-1 text-[15px] font-bold">{ scene.Name }</span>
		<span class={ "px-2 py-0.5 rounded-box text-[13px] font-bold",
			templ.KV("bg-error/15", total > 0 && score*100 < types.PassPct*total),
			templ.KV("bg-success/15", total == 0 || score*100 >= types.PassPct*total) }>
			{ fmt.Sprint(score) } / { fmt.Sprint(total) }
		</span>
	</div>
	if hint != "" {
		<div class="px-3 py-2.5 rounded bg-base-200 text-[12.5px] leading-relaxed">
			<i class="fa-solid fa-lightbulb text-[11px] opacity-60 mr-1.5" aria-hidden="true"></i>
			{ hint }
		</div>
	}
	if len(rows) == 0 {
		<p class="text-sm opacity-60 py-4">This minigame doesn't have any questions yet.</p>
	} else {
		<div class="grid grid-cols-[1fr_70px_70px_26px] px-1 text-xs font-bold opacity-60">
			<span>Question</span>
			<span class="text-center">Correct</span>
			<span class="text-center">Their answer</span>
			<span></span>
		</div>
		<input type="checkbox" id="quiz-detail-show-all" class="hidden peer"/>
		for i, r := range rows {
			<div class={ "grid grid-cols-[1fr_70px_70px_26px] items-center gap-2 py-2 px-1 border-t border-base-300 text-[13.5px]",
				templ.KV("hidden peer-checked:grid", i >= 7) }>
				<span class="truncate">{ r.Question }</span>
				<span class="text-center font-semibold">{ r.Correct }</span>
				<span class="text-center font-semibold">{ r.Answer }</span>
				if r.Right {
					<i class="fa-solid fa-check text-success text-center" aria-hidden="true"></i>
				} else {
					<i class="fa-solid fa-xmark text-error text-center" aria-hidden="true"></i>
				}
			</div>
		}
		if len(rows) > 7 {
			<label for="quiz-detail-show-all" class="text-[13px] link link-primary cursor-pointer peer-checked:hidden">Show all { fmt.Sprint(len(rows)) } questions</label>
		}
	}
}

// FractionDetail is the scene-detail panel's content for a fraction/worded scene tile:
// title, then fractionQuestionRow's existing Question/Answer/Right/Wrong/%-bar row
// (fraction.templ, T5.4's By-question table) reused as-is for this one student's
// counts instead of the whole class's - same shape either way, and Op already fixes
// X9's hard-coded "+" for the subtraction scenes.
templ FractionDetail(scene types.Scene, rows []FractionQuestionStat) {
	<div class="flex items-center gap-2.5 mb-1">
		<img src={ scene.Image } alt="" class="w-7 h-[34px] rounded object-cover object-[center_35%] [image-rendering:pixelated]"/>
		<span class="flex-1 text-[15px] font-bold">{ scene.Name }</span>
	</div>
	if len(rows) == 0 {
		<p class="text-sm opacity-60 py-4">This minigame doesn't have any questions yet.</p>
	} else {
		<table class="w-full text-[14.5px]">
			<thead>
				<tr class="text-xs font-bold opacity-60 text-left">
					<th class="py-2"></th>
					<th>Question</th>
					<th>Answer</th>
					<th class="text-center">Right</th>
					<th class="text-center">Wrong</th>
					<th>% correct</th>
				</tr>
			</thead>
			<tbody>
				for _, q := range rows {
					@fractionQuestionRow(q)
				}
			</tbody>
		</table>
	}
}

// MinigameAttemptRow is one fraction/worded scene's right/wrong tally for the
// Minigame attempts card (01 §1h). Quiz scenes don't appear here - they're scored, not
// attempted, and already summarized by the Quiz average stat card above.
type MinigameAttemptRow struct {
	Scene        types.Scene
	Right, Wrong int
	AccuracyPct  int
}

// MinigameAttempts is the student page's right-hand card (01 §1h): static per page
// load, unlike the left scene-detail panel, since it always shows every fraction/
// worded scene at once rather than following the journey-tile selection.
templ MinigameAttempts(rows []MinigameAttemptRow) {
	<div class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-1.5">
		<span class="text-[15px] font-bold mb-1">Minigame attempts</span>
		<div class="grid grid-cols-[1fr_56px_56px_96px] px-1 text-xs font-bold opacity-60">
			<span>Scene</span>
			<span class="text-center">Right</span>
			<span class="text-center">Wrong</span>
			<span>% correct</span>
		</div>
		for _, r := range rows {
			@minigameAttemptRow(r)
		}
	</div>
}

templ minigameAttemptRow(r MinigameAttemptRow) {
	<div class="grid grid-cols-[1fr_56px_56px_96px] items-center gap-2 py-1.5 px-1 border-t border-base-300 text-[13.5px]">
		<div class="flex items-center gap-2 min-w-0">
			<img src={ r.Scene.Image } alt="" class="w-5 h-[25px] rounded-sm shrink-0 object-cover object-[center_35%] [image-rendering:pixelated]"/>
			<span class="truncate">{ r.Scene.Name }</span>
		</div>
		<span class="text-center">{ fmt.Sprint(r.Right) }</span>
		<span class="text-center">{ fmt.Sprint(r.Wrong) }</span>
		<div class="flex items-center gap-1.5">
			<div class="w-11 h-1.5 rounded bg-base-300 overflow-hidden shrink-0">
				<div class={ "h-full", widthPct(max(r.AccuracyPct, 0)),
					templ.KV("bg-error", r.AccuracyPct >= 0 && r.AccuracyPct < types.PassPct),
					templ.KV("bg-success", r.AccuracyPct >= types.PassPct) }>
				</div>
			</div>
			<span class="text-[12.5px] font-bold">{ ui.Pct(r.AccuracyPct) }</span>
		</div>
	</div>
}
