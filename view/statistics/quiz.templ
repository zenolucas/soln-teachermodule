package statistics

import (
	"fmt"
	"math"
	"strconv"

	"soln-teachermodule/types"
	"soln-teachermodule/view/layout"
	"soln-teachermodule/view/ui"
)

// QuizPage is the merged quiz statistics page (01 §1g): a Summary section (four stat
// cards, a CSS score-distribution histogram, and the lowest-scoring students), then
// By question and By student. All three are stacked on one page - the "tabs" above
// them are plain #-anchor jump links (the mockup's own height, ~1260px, is a single
// tall scrolling page, not a JS-driven one-pane-at-a-time tab switcher) - so nothing
// here needs client-side tab logic.
//
// classroomID/minigameID are extra beyond TASKS.md's original sketch
// (p, h, sum, lowest, total, byQuestion): PageHeader's action slot (the scene picker
// and "Edit questions" button) is built inline here, the same way every other
// PageHeader caller in this codebase does it (e.g. classroom/overview.templ's "Add
// students"), and that needs both ids to build its links.
//
// lowest is every enrolled student's score, sorted ascending (DEC-9's latest
// attempt) - the Summary card only shows the first 8, but By student iterates all of
// them, so there's one slice to keep in sync rather than two.
templ QuizPage(p layout.Page, h ui.Header, classroomID, minigameID string, sum types.QuizSummary, lowest []types.StudentScore, total int, byQuestion templ.Component) {
	@layout.Base(p) {
		<div class="w-full min-h-full bg-base-300 flex flex-col gap-4 p-4">
			@ui.PageHeader(h) {
				@ScenePicker(classroomID, atoiOrZero(minigameID))
				<a href={ templ.URL(fmt.Sprintf("/minigame?minigameID=%s&classroomID=%s", minigameID, classroomID)) } class="btn btn-sm bg-base-200">
					<i class="fa-solid fa-pen text-xs" aria-hidden="true"></i>
					Edit questions
				</a>
			}
			<div role="tablist" class="tabs tabs-bordered px-4">
				<a href="#summary" class="tab tab-active">Summary</a>
				<a href="#by-question" class="tab">By question</a>
				<a href="#by-student" class="tab">By student</a>
			</div>
			<div id="summary" class="flex flex-col gap-4 px-4 scroll-mt-4">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-3.5">
					<div class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-0.5">
						<span class="text-[12.5px] opacity-60">Class average</span>
						<span class="text-2xl font-bold">
							{ ui.Pct(sum.AvgPct) }
							<span class="text-sm font-semibold opacity-60">{ formatScore(sum.AvgScore) } / { fmt.Sprint(total) }</span>
						</span>
					</div>
					<div class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-0.5">
						<span class="text-[12.5px] opacity-60">Median score</span>
						<span class="text-2xl font-bold">
							{ formatScore(sum.Median) }
							<span class="text-sm font-semibold opacity-60">/ { fmt.Sprint(total) }</span>
						</span>
					</div>
					<div class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-0.5">
						<span class="text-[12.5px] opacity-60">Took the quiz</span>
						<span class="text-2xl font-bold">
							{ fmt.Sprint(sum.Took) }
							<span class="text-sm font-semibold opacity-60">/ { fmt.Sprint(sum.Enrolled) }</span>
						</span>
					</div>
					<div class="bg-base-100 rounded-box border border-error/45 p-4 flex flex-col gap-0.5">
						<span class="text-[12.5px] opacity-60 flex items-center gap-1.5">
							<span class="w-[7px] h-[7px] rounded-full bg-error"></span>
							Scored below 60%
						</span>
						<span class="text-2xl font-bold">{ fmt.Sprint(sum.Below) }</span>
					</div>
				</div>
				<div class="grid grid-cols-1 lg:grid-cols-[1.35fr_1fr] gap-4">
					<div class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-3">
						<div class="flex items-baseline justify-between">
							<span class="text-[15px] font-bold">Score distribution</span>
							<div class="flex gap-3.5 text-xs opacity-60">
								<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-error"></span>Below 60%</span>
								<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-primary"></span>60% and up</span>
							</div>
						</div>
						<div class="flex items-end gap-1.5 h-[220px] border-b border-base-content/20">
							for score, count := range sum.Histogram {
								<div class="flex-1 flex flex-col items-center justify-end gap-1 h-full min-w-0">
									if count > 0 {
										<span class="text-[11px] font-semibold">{ fmt.Sprint(count) }</span>
									}
									<div class={ "w-full rounded-t", histBarPct(barPct(count, histMax(sum.Histogram))),
										templ.KV("bg-error", total > 0 && score*100 < types.PassPct*total),
										templ.KV("bg-primary", total == 0 || score*100 >= types.PassPct*total) }>
									</div>
								</div>
							}
						</div>
						<div class="flex gap-1.5 text-[11px] opacity-60">
							for score := range sum.Histogram {
								<span class="flex-1 text-center">{ fmt.Sprint(score) }</span>
							}
						</div>
						<span class="text-xs opacity-60 text-center">Score out of { fmt.Sprint(total) } · number of students</span>
					</div>
					<div class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-0.5">
						<div class="flex items-center justify-between mb-1">
							<span class="text-[15px] font-bold">Student scores</span>
							<span class="text-xs opacity-60">Lowest first</span>
						</div>
						for _, s := range firstN(lowest, 8) {
							@studentScoreRow(s)
						}
						if len(lowest) > 0 {
							<a href="#by-student" class="text-[13px] link link-primary mt-1.5">All { fmt.Sprint(len(lowest)) } students</a>
						}
					</div>
				</div>
			</div>
			<div id="by-question" class="scroll-mt-4">
				@byQuestion
			</div>
			<div id="by-student" class="bg-base-100 rounded-box border border-base-content/10 p-4 flex flex-col gap-0.5 mx-4 mb-4 scroll-mt-4">
				<span class="text-[15px] font-bold mb-1">By student</span>
				if len(lowest) == 0 {
					<p class="text-sm opacity-60 py-4">No students have taken this quiz yet.</p>
				} else {
					for _, s := range lowest {
						@studentScoreRow(s)
					}
				}
			</div>
		</div>
	}
}

templ studentScoreRow(s types.StudentScore) {
	<div class="flex items-center gap-2.5 pt-2 border-t border-base-300 first:border-t-0 first:pt-0">
		<span class="w-[26px] h-[26px] shrink-0 rounded-full bg-secondary text-base-content flex items-center justify-center text-[10.5px] font-bold">
			{ ui.Initials(s.First, s.Last) }
		</span>
		<span class="flex-1 min-w-0 text-[13.5px] font-semibold truncate">{ s.First } { s.Last }</span>
		<div class="w-20 h-1.5 rounded bg-base-300 overflow-hidden shrink-0">
			<div class={ "h-full", scoreBarPct(s.Score, s.Total),
				templ.KV("bg-error", s.Total > 0 && s.Score*100 < types.PassPct*s.Total),
				templ.KV("bg-primary", s.Total == 0 || s.Score*100 >= types.PassPct*s.Total) }>
			</div>
		</div>
		<span class="w-9 text-right text-[13.5px] font-bold shrink-0">{ fmt.Sprint(s.Score) }</span>
	</div>
}

// LegacyByQuestionFragment is the placeholder By-question pane content (T5.2 step 6):
// it keeps loading today's Chart.js-based per-question fragment until T5.3 replaces
// it with the real hint-enabled design, so the caller (renderStatisticsPage) also
// keeps Page.Charts true for now. The trigger (a bare <form>) and the swap target
// (#question-chart-container) are deliberately two separate elements, matching every
// existing caller of this same fragment endpoint (FractionStatistics,
// WordedStatistics, QuestionStatistics in statistics.templ) exactly, rather than the
// simpler single-element hx-target="this" this task started with.
templ LegacyByQuestionFragment(classroomID, minigameID string) {
	<form hx-get={ fmt.Sprintf("/statistics/quiz/question/chart?minigameID=%s&classroomID=%s", minigameID, classroomID) } hx-swap="outerHTML" hx-target="#question-chart-container" hx-trigger="load">
	</form>
	<div id="question-chart-container">
		<div class="flex justify-center p-8"><span class="loading loading-spinner" aria-label="Loading"></span></div>
	</div>
}

// histBarPct/scoreBarPct are templ css functions, not Tailwind classes, for the same
// reason as every other runtime-percentage bar in this revamp (see
// view/minigame/fraction.templ's barWidthPct): the JIT compiler can't generate CSS
// for a class string built at runtime.
css histBarPct(pct int) {
	height: { fmt.Sprintf("%d%%", pct) };
}

css scoreBarPct(score, total int) {
	width: { fmt.Sprintf("%d%%", pctOf(score, total)) };
}

func pctOf(n, total int) int {
	if total <= 0 {
		return 0
	}
	return n * 100 / total
}

// histMax/barPct scale the distribution chart's bars to its own tallest bar (not a
// fixed 0-100 scale) - "6 students" should read as a full-height bar when 6 is the
// most anyone got, the same way the mockup's own hint-placeholder data does.
func histMax(hist []int) int {
	m := 0
	for _, n := range hist {
		if n > m {
			m = n
		}
	}
	return m
}

func barPct(count, max int) int {
	if max == 0 {
		return 0
	}
	return count * 100 / max
}

// formatScore drops the decimal when a score/median is a whole number ("7", not
// "7.0"), and keeps one decimal place otherwise ("6.6").
func formatScore(v float64) string {
	if v == math.Trunc(v) {
		return fmt.Sprintf("%d", int(v))
	}
	return fmt.Sprintf("%.1f", v)
}

// firstN caps a slice to its first n elements without panicking when it's shorter.
func firstN[T any](s []T, n int) []T {
	if len(s) < n {
		return s
	}
	return s[:n]
}

// atoiOrZero parses minigameID for ScenePicker's "current" comparison - a malformed
// or missing id just means no option shows as selected, not an error page (this is
// display-only; the handler already validated the id before reaching this render).
func atoiOrZero(s string) int {
	n, _ := strconv.Atoi(s)
	return n
}
