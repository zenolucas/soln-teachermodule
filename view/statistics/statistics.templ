package statistics

import "soln-teachermodule/view/layout"
import "soln-teachermodule/view/ui"
import "fmt"

templ FractionStatistics(classroomID string, minigameID string, classroomName string, sceneName string) {
@layout.App(true, false, true, "Simple Fraction Statistics · Sol'n Teacher Portal") {
@ui.Breadcrumb(classroomID, classroomName, sceneName, "Statistics")
    <div class="flex justify-center items-center flex-col w-full h-140 mt-4">
        <h1 class="text-5xl font-bold mt-2 mb-4">Simple Fraction Statistics</h1>

        <form hx-get={ string(templ.URL(fmt.Sprintf("/statistics/fraction/question/chart?minigameID=%s&classroomID=%s", minigameID, classroomID)))} hx-swap="outerHTML" hx-target="#question-chart-container" hx-trigger="load">
        </form>

        <div id="question-chart-container">
        <div class="flex justify-center w-full p-8"><span class="loading loading-spinner loading-lg" aria-label="Loading"></span></div>
        </div>

    </div>
    }
}


